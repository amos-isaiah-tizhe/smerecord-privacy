# ─── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB (Cloud Atlas) ─────────────────────────────────────────────
# Get this from MongoDB Atlas → Database → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smerecord?retryWrites=true&w=majority

# ─── JWT Secrets ───────────────────────────────────────────────────────
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# They MUST be different from each other.
JWT_SECRET=replace_me_with_a_64_byte_hex_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_me_with_a_DIFFERENT_64_byte_hex_string

# ─── SMTP (optional — for verification + password reset emails) ────────
# In dev you can use Mailtrap (sandbox.smtp.mailtrap.io).
# In prod use SendGrid, Mailgun, Brevo, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="SME Record <youraddress@gmail.com>"
FRONTEND_URL=http://localhost:5000

# ─── Cloudflare (optional — for security headers) ──────────────────────

TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_here
TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key_here

# ─── URLs ──────────────────────────────────────────────────────────────
# Local dev: same origin as the backend (Express serves the static
# frontend in production AND development from / )
CLIENT_URL=http://localhost:5000
RENDER_EXTERNAL_URL=https://your-app.onrender.com
